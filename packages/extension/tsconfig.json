{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vscode", "node"],
    "baseUrl": ".",
    "paths": {
      "@shared": ["shared/index.ts"]
    }
  },
  "include": ["src", "shared"],
  "exclude": ["src/**/*.test.ts"]
}
